rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // An admin is anyone with a matching document at /admins/{uid}. This is
    // the SAME check the client UI uses (see src/services/auth.ts), enforced
    // here independently so the client check is never trusted on its own.
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'owner';
    }

    function positiveAmount() {
      return request.resource.data.amount is number && request.resource.data.amount > 0;
    }

    // ---------------- Financial records: PRIVATE, admin-only ----------------
    // These hold the real donor name, private notes, and the admin uid that
    // recorded each entry — never readable by the public. The app writes a
    // matching privacy-safe copy to donationsPublic/expensesPublic below,
    // which is what the public Transparency page actually reads.

    match /donations/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && positiveAmount();
      allow delete: if isAdmin();
    }

    match /expenses/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && positiveAmount();
      allow delete: if isAdmin();
    }

    // ---------------- Financial records: PUBLIC, privacy-safe copy ----------------
    // Only date, a pre-computed display name (or title/category), and
    // amount. No real donor name, no note, no admin uid ever lands here —
    // enforced by only allowing admin writes, paired with the app only ever
    // constructing these documents from src/services/donations.ts and
    // src/services/expenses.ts.

    match /donationsPublic/{id} {
      allow read: if true;
      allow write: if isAdmin() && positiveAmount();
    }

    match /expensesPublic/{id} {
      allow read: if true;
      allow write: if isAdmin() && positiveAmount();
    }

    // ---------------- Public festival content ----------------
    // Read: open to everyone. Write: admins only.

    match /events/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gallery/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      // settings/site and settings/payment
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------- Protected administrative data ----------------

    match /admins/{uid} {
      // Admins can see the roster (needed for the Admin Users screen), but
      // only owners can grant or revoke access. An admin may never edit
      // their own role.
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update, delete: if isOwner() && request.auth.uid != uid;
    }

    match /auditLogs/{id} {
      // Audit trail: any admin can read; any admin can append; nobody can
      // edit or delete a log entry (immutable trail).
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
